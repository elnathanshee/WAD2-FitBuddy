# =============================================================================
# HabitBuddy Environment Configuration
# =============================================================================

# Server Port (default 3000)
PORT=3000

# 1. Neon PostgreSQL Connection String (REQUIRED FOR LOCAL & VERCEL)
# Get your connection string from neon.tech -> Dashboard -> Connection Details
DATABASE_URL=postgresql://<user>:<password>@<ep-xyz>.neon.tech/neondb?sslmode=require

# 2. Google Gemini API Key for AI Goal Coach (OPTIONAL)
# Get your free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 3. OneSignal REST API for Web Push Notifications & Day-Ending Alerts (OPTIONAL)
# Falls back to simulated/local browser notifications when left blank.
# Create a free account & app at https://onesignal.com -> Settings -> Keys & IDs
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Note: Google Health runs in simulated wearable data mode out-of-the-box
# (steps, active minutes, distance, calories, and automatic habit check-in sync).
# No Google OAuth credentials are needed.
