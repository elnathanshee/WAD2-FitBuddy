{
  "name": "habitbuddy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "seed:neon": "node --env-file-if-exists=.env seedNeon.js",
    "seed:friends": "node --env-file-if-exists=.env seedFriends.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@neondatabase/serverless": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.2"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
