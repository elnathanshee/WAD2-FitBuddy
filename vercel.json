{
  "installCommand": "npm install",
  "buildCommand": "npm install --prefix FitBuddy --include=dev && npm run build --prefix FitBuddy",
  "outputDirectory": "FitBuddy/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
