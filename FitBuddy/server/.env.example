# =============================================================================
# HabitBuddy Environment Configuration
# =============================================================================

# Server Port (default 3000)
PORT=3000

# Google Health API (real provider connection; never put these values in frontend env vars)
GOOGLE_HEALTH_CLIENT_ID=your_google_cloud_oauth_web_client_id
GOOGLE_HEALTH_CLIENT_SECRET=your_google_cloud_oauth_web_client_secret
APP_URL=https://wad-2-fit-buddy.vercel.app
GOOGLE_HEALTH_REDIRECT_URI=https://wad-2-fit-buddy.vercel.app/api/health-sync/google/callback
# Generate a private random value and store it only in server/Vercel environment variables.
HEALTH_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret

# 1. Neon PostgreSQL Connection String (RECOMMENDED & FOR VERCEL)
# Get your connection string from neon.tech -> Dashboard -> Connection Details
DATABASE_URL=postgresql://<user>:<password>@<ep-xyz>.neon.tech/neondb?sslmode=require

# 2. Google Gemini API Key for AI Goal Coach
# Get your free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 3. OneSignal REST API (for Web Push Notifications & Habit Reminders)
# Create a free account & app at https://onesignal.com -> Settings -> Keys & IDs
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
