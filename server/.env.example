# Copy this file to .env and fill in your MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers → copy the URI, replace <password>,
# and put the database name before the "?" (e.g. .../habitbuddy?retryWrites=true)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/habitbuddy?retryWrites=true&w=majority
PORT=3000
