{
  "name": "habitbuddy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "seed": "node --env-file-if-exists=.env seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "dev:memory": "node --watch dev-memory.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongoose": "^8.24.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
